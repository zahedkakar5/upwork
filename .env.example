# Copy to .env; enter keys locally. Never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI alternative: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Use a random value for stable local preview sessions; keep it private.
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:8765
NEXT_TELEMETRY_DISABLED=1

# Upwork OAuth (approved API app required). Register this callback in Upwork:
# https://your-domain.example/api/upwork/callback
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Only if required for your approved Upwork API tenant:
UPWORK_TENANT_ID=
