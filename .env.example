# Copy to .env; enter keys locally. Never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI alternative: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Use a random value for stable local preview sessions; keep it private.
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:8765
NEXT_TELEMETRY_DISABLED=1

# Upwork MCP uses OAuth 2.1 dynamic client registration and PKCE.
# No Upwork client ID, client secret, or API tenant ID is required.
# APP_ORIGIN must be the exact public HTTPS origin in production.
